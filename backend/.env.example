# MongoDB connection string (required), e.g. MongoDB Atlas
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DATABASE_NAME=aura_data_intelligence

# Secret used to sign login tokens (required in production).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=24

# Google Gemini API key for AI insights and the AI Analyst chat (optional)
GEMINI_API_KEY=

# Extra allowed frontend origins, comma separated (localhost is always allowed)
CORS_ORIGINS=

# Maximum upload size in megabytes
MAX_UPLOAD_MB=50
